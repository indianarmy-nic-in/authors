<!-- JavaScript for Auto-Slide (3 Seconds) -->
<script>
  let slideIndex = 0;
  const track = document.getElementById('banner-track');
  const totalBanners = document.querySelectorAll('.slide-item').length;

  setInterval(() => {
    slideIndex++;
    // अगर बैनर खत्म हो जाएं, तो वापस पहले पर आ जाए
    if (slideIndex >= totalBanners) {
      slideIndex = 0; 
    }
    // स्लाइड को खिसकाने का लॉजिक
    track.style.transform = `translateX(-${slideIndex * 100}%)`;
  }, 3000); // 3000 मिलीसेकंड = 3 सेकंड
