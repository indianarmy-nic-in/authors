            function processRedirect() {
                const passInp = document.getElementById('stuPassword').value.trim();
                const btn = document.getElementById('submitBtn');
                const loader = document.getElementById('kcLoader');
                const error = document.getElementById('kc-error');

                const student = kcData.find(s => s.password === passInp);

                if (student) {
                    error.style.display = 'none';
                    btn.style.display = 'none';
                    loader.style.display = 'block';

                    setTimeout(() => {
                        window.open(student.url, '_blank');
                        closeKC();
                    }, 5000);
                } else {
                    error.style.display = 'block';
                }
            }

