    // Safety check
    if(!track) return;

    bookImages.forEach(src => {
        const card = document.createElement('div');
        card.className = 'bookslider-card';
        card.innerHTML = `<img src="${src}" loading="lazy">`;
        track.appendChild(card);
    });

    let bookIdx = 0;

    function moveBookSlider() {
        let isMob = window.innerWidth <= 600;
        let visible = isMob ? 3 : 4; 
        let move = 2; // Do-do karke slide
        
        bookIdx += move;

        if (bookIdx > bookImages.length - visible) {
            bookIdx = 0;
        }

        const cardWidth = track.querySelector('.bookslider-card').offsetWidth;
        const gap = 10; 
        const dist = bookIdx * (cardWidth + gap);
        track.style.transform = `translateX(-${dist}px)`;
    }

    setInterval(moveBookSlider, 4000);

    window.addEventListener('resize', () => {
        bookIdx = 0;
        track.style.transform = `translateX(0)`;
    });
